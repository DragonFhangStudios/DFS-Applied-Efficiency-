<Window x:Class="app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:app"
        xmlns:viewmodels="clr-namespace:app.ViewModels"
        mc:Ignorable="d"
        Title="CNC Shop Assistant" Height="750" Width="1000"
        Background="#0a0e17" Foreground="#e4e6eb"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Applied Aerospace Blue: #3b82f6 (Light Blue), #1e3a8a (Dark Blue) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0a0e17" />
        <SolidColorBrush x:Key="CardBackground" Color="#1a2332" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#0f1419" />
        <SolidColorBrush x:Key="BorderColor" Color="#2d3748" />
        <SolidColorBrush x:Key="PrimaryText" Color="#e4e6eb" />
        <SolidColorBrush x:Key="SecondaryText" Color="#8b92a7" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3b82f6" />
        <SolidColorBrush x:Key="AccentDarkBlue" Color="#1e3a8a" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#10b981" />
        <SolidColorBrush x:Key="WarningOrange" Color="#f59e0b" />

        <!-- Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource WarningOrange}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d97706" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Industrial TabItem Style -->
        <Style x:Key="IndustrialTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Background" Value="#1A3B82F6"/> <!-- 10% opacity blue -->
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource IndustrialTabItem}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e3a8a" Offset="0"/>
                    <GradientStop Color="#3b82f6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🔧 CNC Shop Assistant" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Multi-User Production Tracking System" FontSize="14" Foreground="White" Opacity="0.9"/>
                <TextBlock Text="Version 2.5 - Complete Edition" FontSize="12" Foreground="White" Opacity="0.7" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Content Wrapper -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard">
                <ScrollViewer Padding="20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column (Stats & Actions) -->
                        <StackPanel Grid.Column="0">
                            <!-- Current User Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Current User" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                        <Button Content="Change" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding ChangeUserCommand}" Padding="8,4" FontSize="12"/>
                                    </Grid>
                                    <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessGreen}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CurrentUser}" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Stats Grid -->
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,15">
                                <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,8,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ToolCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tools" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="8,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding GaugeCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Gauges" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,8,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ProductionToday}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Parts Today" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="8,8,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LogCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Log Entries" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Quick Actions -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,15"/>
                                    <!-- Index 2 is Gauges Tab -->
                                    <Button Content="📏 Manage Gauges" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" HorizontalContentAlignment="Left" Padding="15,10"
                                            Command="{Binding NavigateToTabCommand}" CommandParameter="2"/>
                                    <!-- Index 3 is Production Tab -->
                                    <Button Content="📊 Log Production" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,0,10" HorizontalContentAlignment="Left" Padding="15,10"
                                            Command="{Binding NavigateToTabCommand}" CommandParameter="3"/>
                                    <!-- Index 6 is Export Tab -->
                                    <Button Content="📥 Export Data" Style="{StaticResource WarningButtonStyle}" HorizontalContentAlignment="Left" Padding="15,10"
                                            Command="{Binding NavigateToTabCommand}" CommandParameter="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column (NPI & Precision Math) -->
                        <StackPanel Grid.Column="2">
                            <!-- New Product Introduction (NPI) -->
                            <Border Style="{StaticResource CardStyle}" BorderBrush="#a855f7" BorderThickness="1,1,1,4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="🚀 New Product Introduction (NPI)" FontSize="18" FontWeight="SemiBold" Foreground="#a855f7"/>
                                    </Grid>
                                    <TextBlock Text="Track setup notes, observations, and tasks for new products." FontSize="14" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15"/>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NpiNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="40" Background="{StaticResource SecondaryBackground}"/>
                                        <Button Grid.Column="2" Content="Add Note" Command="{Binding AddNpiTaskCommand}" Style="{StaticResource PrimaryButtonStyle}" Background="#a855f7"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding NpiTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📌" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource PrimaryText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Aerospace Precision Math (True Position) -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📐 Aerospace True Position Calculator" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,15"/>
                                    <TextBlock Text="High-precision decimal calculation for geometric tolerancing." FontSize="14" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Target X" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding TargetX, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Actual X" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding ActualX, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Target Y" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding TargetY, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Actual Y" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding ActualY, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="Calculate True Position" Command="{Binding CalculateTruePositionCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,20"/>

                                    <Border Background="{StaticResource SecondaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="True Position Result" FontSize="14" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding TruePositionResult, StringFormat=F5}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <TextBlock Text="Tools Area" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            <TabItem Header="Gauges">
                <TextBlock Text="Gauges Area" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            <TabItem Header="Production">
                <TextBlock Text="Production Area" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            <TabItem Header="Log">
                <TextBlock Text="Log Area" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            <TabItem Header="Updates">
                <TextBlock Text="Updates Area" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            <TabItem Header="Export">
                <TextBlock Text="Export Area" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            <TabItem Header="About">
                <TextBlock Text="About CNC Shop Assistant" Foreground="{StaticResource PrimaryText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>